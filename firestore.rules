rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow all access
    match /{collectionName}/{document} {
    	allow read: if collectionName == "geo_communes";
      allow read: if collectionName == "geo_districts";
      allow read: if collectionName == "geo_provinces";
      allow read: if collectionName == "geo_villages";
      allow read: if collectionName == "users";
      allow read: if collectionName == "sys_apps" && document == "app_edoc";
      allow read: if collectionName == "settings" && document == "config";
      allow read, write: if request.auth != null;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}